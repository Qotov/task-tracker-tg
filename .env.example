# Copy to .env and fill in. Never commit .env.

# From @BotFather. Required.
BOT_TOKEN=

# The two Telegram user ids allowed to use the bot, comma-separated. Required.
ALLOWED_USER_IDS=

# Path to the SQLite file. Optional, defaults to ./tasks.db
DB_PATH=

# Display timezone. Optional, defaults to Europe/Paris
TZ=

# Optional second-chance parser for messages the rule parser finds no date in.
# Leave GEMINI_API_KEY empty and nothing is ever sent anywhere.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite
GEMINI_MODEL=

# Optional chat id that scripts/backup.sh uploads the nightly backup to.
BACKUP_CHAT_ID=

# Public holidays to flag on a due date: FR, or off. Optional, defaults to FR
HOLIDAYS=
