<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the bot running on a Mac: starts at login, survives a closed terminal
  and a logout, and is restarted if it ever exits.

  It does NOT run while the Mac is asleep. Nothing is lost — the outbox holds
  every notification and delivers it on the next tick — but a digest due at 08:00
  arrives when the lid opens. For reminders that land on time, run it on a
  machine that stays awake; see docs/DEPLOY.md.

  Install:  make service
  Stop:     make service-stop
  Logs:     tail -f /tmp/task-tracker.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.task-tracker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/sanchous/.local/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>bot.main</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sanchous/Documents/GitHub/task-tracker-tg</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- If it dies on startup — a broken .env, say — do not respawn in a tight
       loop. Ten seconds is long enough to read the log and fix it. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/tmp/task-tracker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/task-tracker.log</string>
</dict>
</plist>
